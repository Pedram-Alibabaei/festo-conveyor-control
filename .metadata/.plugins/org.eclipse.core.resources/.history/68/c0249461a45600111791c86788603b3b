// ============================================================================
// DURCHREICHE-METHODEN FÜR DAS NETZWERK
// ============================================================================
void Dispatcher::workpieceInfo(int id, WpType type) {
    if (m_partnerCoid != -1) {
        uint32_t payload = (static_cast<uint32_t>(id) << 16) | static_cast<uint32_t>(type);
        MsgSendPulse(m_partnerCoid, SIGEV_PULSE_PRIO_INHERIT, ipc::WP_INFO, payload);
        std::cout << "[Dispatcher] workpieceInfo an Partner gesendet (ID: " << id << ")!" << std::endl;
    }
}

void Dispatcher::RequestToReceiveWp() {
    if (m_partnerCoid != -1) {
        uint32_t payload = ipc::encodeHalPayload(0, ipc::NetworkMessage::REQ_RECEIVE);
        MsgSendPulse(m_partnerCoid, SIGEV_PULSE_PRIO_INHERIT, ipc::PARTNER_MSG, payload);
        std::cout << "[Dispatcher] RequestToReceiveWp an Partner gesendet!" << std::endl;
    }
}

void Dispatcher::readyToReceiveWp() {
    if (m_partnerCoid != -1) {
        uint32_t payload = ipc::encodeHalPayload(0, ipc::NetworkMessage::READY_RECEIVE);
        MsgSendPulse(m_partnerCoid, SIGEV_PULSE_PRIO_INHERIT, ipc::PARTNER_MSG, payload);
        std::cout << "[Dispatcher] readyToReceiveWp an Partner gesendet!" << std::endl;
    }
}

void Dispatcher::updateWpListe(WpType type) {
    if (m_partnerCoid != -1) {
        MsgSendPulse(m_partnerCoid, SIGEV_PULSE_PRIO_INHERIT, ipc::UPDATE_LIST, static_cast<uint32_t>(type));
        std::cout << "[Dispatcher] updateWpListe an Partner gesendet!" << std::endl;
    }
}

// ============================================================================
// LOKALER E-STOP (Jemand hat den Taster an DIESEM Modul gedrückt)
// ============================================================================
void Dispatcher::handleHalEStopPulse(uint32_t payload) {
    uint16_t sensor_id = ipc::decodeSensorID(payload);
    uint16_t sensor_state = ipc::decodeSensorState(payload);

    if (!m_actuators) return;

    if (sensor_id == ipc::BTN_ESTOP) {

        // ZUSTAND: Taster REINGEDRÜCKT (Gefahr!)
        if (sensor_state == ipc::State::RELEASED) {
            std::cerr << "\n!!! EMERGENCY: Lokaler E-STOP gedrueckt !!!" << std::endl;

            m_actuators->turnAllOff();
            m_actuators->driveStop();
            m_actuators->lightRedBlinkFast();
            // m_actuators->lightQ2BlinkFast(); // Lokalisierung: Hier wurde gedrückt!

            std::cout << "[E-Stop] Konsole: Ausloesung erfolgte an diesem Modul!" << std::endl;

            // Systemweite Kopplung: Partner informieren, dass wir GEDRÜCKT wurden
            if (m_partnerCoid != -1) {
                uint32_t netPayload = ipc::encodeHalPayload(ipc::BTN_ESTOP, ipc::State::RELEASED);
                MsgSendPulse(m_partnerCoid, SIGEV_PULSE_PRIO_INHERIT, ipc::PARTNER_ESTOP, netPayload);
            }
        }

        // ZUSTAND: Taster ENTRIEGELT (Herausgezogen)
        else if (sensor_state == ipc::State::PRESSED) {
            std::cout << "[E-Stop] Lokaler Taster entriegelt. Warte auf Partner..." << std::endl;

            // Partner informieren, dass wir ENTRIEGELT wurden
            if (m_partnerCoid != -1) {
                uint32_t netPayload = ipc::encodeHalPayload(ipc::BTN_ESTOP, ipc::State::PRESSED);
                MsgSendPulse(m_partnerCoid, SIGEV_PULSE_PRIO_INHERIT, ipc::PARTNER_ESTOP, netPayload);
            }

            // Hier später für die FSM: if (m_logik) m_logik->lokalerEStopFreigegeben();
        }
    }
}

// ============================================================================
// PARTNER E-STOP (Die ANDERE Anlage schickt uns ihren Zustand per Netzwerk)
// ============================================================================
void Dispatcher::handlePartnerEStopPulse(uint32_t payload) {
    uint16_t partner_state = ipc::decodeSensorState(payload);

    if (!m_actuators) return;

    // ZUSTAND VOM PARTNER: Taster dort REINGEDRÜCKT
    if (partner_state == ipc::State::RELEASED) {
        std::cerr << "\n!!! EMERGENCY: E-STOP vom Partner-Modul empfangen (PRESSED) !!!" << std::endl;

        // Eigensicherheit: Alles aus!
        m_actuators->turnAllOff();
        m_actuators->driveStop();
        m_actuators->lightRedBlinkFast();
        // m_actuators->lightQ2Off(); // Bleibt aus, weil der Fehler drüben ist

        std::cout << "[E-Stop] Konsole: Ausloesung erfolgte am PARTNER-Modul!" << std::endl;

        // Hier später für die FSM: if (m_logik) m_logik->partnerEStopAktiviert();
    }

    // ZUSTAND VOM PARTNER: Taster dort ENTRIEGELT (Herausgezogen)
    else if (partner_state == ipc::State::PRESSED) {
        std::cout << "[E-Stop] Info vom Partner erhalten: Taster drueben wurde entriegelt (RELEASED)." << std::endl;

        // Wichtig: Unsere Motoren bleiben natürlich weiterhin gestoppt,
        // bis die manuelle Räumung und der Reset an beiden Pulten gedrückt wurde!

        // Hier später für die FSM: if (m_logik) m_logik->partnerEStopFreigegeben();
    }
}

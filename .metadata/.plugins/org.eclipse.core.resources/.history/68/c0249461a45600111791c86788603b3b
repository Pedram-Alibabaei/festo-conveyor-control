// ============================================================================
// KONSTRUKTOR & DESTRUKTOR
// ============================================================================
Dispatcher::Dispatcher()
    : m_chid(-1),
      m_localCoid(-1),
      m_partnerCoid(-1),
      m_running(false),
      m_actuators(nullptr),
      m_connection(nullptr),
      m_attachHandle(nullptr) {
}

Dispatcher::~Dispatcher() {
    stop();

    // Ressourcen sauber freigeben
    if (m_localCoid != -1) ConnectDetach(m_localCoid);
    if (m_partnerCoid != -1) ConnectDetach(m_partnerCoid);
    if (m_chid != -1) ChannelDestroy(m_chid);
}

// ============================================================================
// Initialisierung
// ============================================================================
void Dispatcher::init(AnlagenPosition pos) {
    m_position = pos;
    std::string myName = (pos == VORN_ANLAGE_1) ? "Anlage_1" : "Anlage_2";

    m_attachHandle = name_attach(NULL, myName.c_str(), NAME_FLAG_ATTACH_GLOBAL);
    if (m_attachHandle == nullptr) {
        std::cerr << "[Dispatcher] Fehler: name_attach fehlgeschlagen!" << std::endl;
        return;
    }

    m_chid = m_attachHandle->chid;
    m_localCoid = ConnectAttach(0, 0, m_chid, _NTO_SIDE_CHANNEL, 0);

    std::cout << "[Dispatcher] Bereit auf Kanal " << m_chid
              << " als '" << myName << "' (Lokale COID: " << m_localCoid << ")" << std::endl;
}

void Dispatcher::stop() {
    m_running = false;
}

// ============================================================================
// Hauptschleife (Der Reaktor)
// ============================================================================
void Dispatcher::run() {
    union {
        struct _pulse pulse;
        uint16_t type;
        uint8_t msg_buffer[256];
    } msg;

    m_running = true;
    std::cout << "[Dispatcher] Reaktor-Schleife gestartet..." << std::endl;

    while (m_running) {
        int rcvid = MsgReceive(m_chid, &msg, sizeof(msg), NULL);

        if (rcvid == -1) {
            if (errno == EINTR) continue;
            break;
        }

        if (rcvid == 0) {
            handlePulse(msg.pulse);
        } else {
            if (msg.type == _IO_CONNECT) {
                MsgReply(rcvid, EOK, NULL, 0);
                std::cout << "[Dispatcher] name_open (Handshake) vom Partner akzeptiert!" << std::endl;
            } else {
                MsgError(rcvid, ENOSYS);
            }
        }
    }
}

// ============================================================================
// Zentraler Event-Verteiler
// ============================================================================
void Dispatcher::handlePulse(const struct _pulse& pulse) {
    switch (pulse.code) {

        // ====================================================================
        // LOKALE HARDWARE & SYSTEM
        // ====================================================================
        case ipc::HAL_INPUT:
            handleHalPulse(pulse.value.sival_int);
            break;

        case ipc::HAL_ESTOP:
            // Hochpriorisierter lokaler Not-Halt-Kanal
            std::cout << "[Dispatcher] KRITISCH: Lokaler E-STOP ausgeloest!" << std::endl;
            handleHalEStopPulse(pulse.value.sival_int);
            break;

        case ipc::CONNECTION_MSG:
            handleConnectionPulse(pulse.value.sival_int);
            break;

        case ipc::DISCONNECT:
            std::cerr << "[Dispatcher] ACHTUNG: Verbindung unterbrochen oder Partner-Not-Halt! Stoppe Motoren." << std::endl;
            if (m_actuators) m_actuators->driveStop();
            // Hier spaeter: if (m_logik) m_logik->geheInFehlerzustand();
            break;

        // ====================================================================
        // TIMER EVENTS
        // ====================================================================
        case ipc::BELT_TICK:
            handleTimerPulse(pulse.value.sival_int);
            break;

        case ipc::HEARTBEATTACKT:
            if (m_connection) {
                m_connection->heartbeatTackt();

                if (m_connection->isConnected()) {
                    MsgSendPulse(m_partnerCoid, SIGEV_PULSE_PRIO_INHERIT, ipc::HEARTBEAT, 0);
                }
            }
            break;

        case ipc::SORTER_TIMER_TICK:
            std::cout << "[Dispatcher] Sorter-Zeit abgelaufen! Schliesse/Fahre automatisch ein." << std::endl;
            if (m_actuators) m_actuators->closeJunction();
            break;

        // ====================================================================
        // NETZWERK BASIS
        // ====================================================================
        case ipc::HEARTBEAT:
            if (m_connection && m_connection->isConnected()){
                m_connection->partnerAlive();
            }
            break;

        case ipc::PARTNER_MSG:
            // Wenn eine generische Netzwerknachricht kommt, werten wir sie aus
            if (m_connection) m_connection->partnerAlive();
            handleNetworkPulse(pulse.value.sival_int);
            break;

        case ipc::PARTNER_ESTOP:
            std::cout << "[Dispatcher] Netz-Nachricht: Partner meldet E-STOP!" << std::endl;
            handlePartnerEStopPulse(pulse.value.sival_int);

            // Hier spaeter: if (m_logik) m_logik->setEStopZustand();
            break;

        case ipc::ANLAGE_2_CIID:
            std::cout << "[Dispatcher] Handshake von Anlage 2 empfangen! Starte eigene Suche..." << std::endl;
            if (m_connection && !m_connection->isConnected()) {
                m_connection->connectToPartner();
            }
            break;

        // ====================================================================
        // NETZWERK WERKSTÜCK-ÜBERGABE
        // ====================================================================
        case ipc::WP_INFO: {
            int id = (pulse.value.sival_int >> 16) & 0xFFFF;
            WpType type = static_cast<WpType>(pulse.value.sival_int & 0xFFFF);
            std::cout << "[Dispatcher] Netz-Nachricht: Werkstueck (ID: " << id << ", Typ: " << type << ") im Anflug!" << std::endl;
            // Hier spaeter: if (m_logik) m_logik->empfangeWpInfo(id, type);
            break;
        }

        case ipc::UPDATE_LIST: {
            WpType type = static_cast<WpType>(pulse.value.sival_int);
            std::cout << "[Dispatcher] Netz-Nachricht: Partner bittet um Update der Liste (Typ: " << type << ")." << std::endl;
            // Hier spaeter: if (m_logik) m_logik->updateWpListe(type);
            break;
        }

        default:
            std::cout << "[Dispatcher] Unbekannter Puls-Code: " << (int)pulse.code << std::endl;
            break;
    }
}

void Dispatcher::handleConnectionPulse(uint32_t payload) {
    m_partnerCoid = payload;
    std::cout << "[Dispatcher] Partner-Verbindung aktiv (COID: " << m_partnerCoid << ")" << std::endl;

    if (m_position == HINTEN_ANLAGE_2) {
        std::cout << "[Dispatcher] Sende Initial-Handshake an Anlage 1..." << std::endl;
        MsgSendPulse(m_partnerCoid, SIGEV_PULSE_PRIO_INHERIT, ipc::ANLAGE_2_CIID, 1);
    }
}

// ============================================================================
// EVENT HANDLER LOKAL (HAL)
// ============================================================================
void Dispatcher::handleHalPulse(uint32_t payload) {
    uint16_t sensor_id = ipc::decodeSensorID(payload);
    uint16_t sensor_state = ipc::decodeSensorState(payload);

    if (!m_actuators) return;

    // ========================================================================
    // TASTER & SCHALTER (Nutzen PRESSED / RELEASED)
    // ========================================================================

    // START
    if (sensor_id == ipc::BTN_START) {
        if (sensor_state == ipc::State::PRESSED) {
            std::cout << ">>> [Logik-Trigger] Start gedrueckt! <<<" << std::endl;
            m_actuators->lightGreenBlinkFast();

            // Partner informieren
            if (m_partnerCoid != -1) {
                MsgSendPulse(m_partnerCoid, SIGEV_PULSE_PRIO_INHERIT, ipc::PARTNER_MSG, payload);
            }
        }
        else if (sensor_state == ipc::State::RELEASED) {
            std::cout << ">>> [Logik-Trigger] Start losgelassen! <<<" << std::endl;
            m_actuators->lightGreenOff();
            if (m_partnerCoid != -1) {
                MsgSendPulse(m_partnerCoid, SIGEV_PULSE_PRIO_INHERIT, ipc::PARTNER_MSG, payload);
            }
        }
    }
    // RESET
    else if (sensor_id == ipc::BTN_RESET) {
        if (sensor_state == ipc::State::PRESSED) {
            std::cout << ">>> [Logik-Trigger] Reset gedrueckt! <<<" << std::endl;
            m_actuators->lightYellowBlinkFast();
        }
        else if (sensor_state == ipc::State::RELEASED) {
            std::cout << ">>> [Logik-Trigger] Reset losgelassen! <<<" << std::endl;
            m_actuators->lightYellowOff();
        }
    }
    // STOP
    else if (sensor_id == ipc::BTN_STOP) {
        if (sensor_state == ipc::State::RELEASED) {
            std::cout << ">>> [Logik-Trigger] Stop gedrueckt! <<<" << std::endl;
            m_actuators->lightRedBlinkSlow();

        }
        else if (sensor_state == ipc::State::PRESSED) {
            std::cout << ">>> [Logik-Trigger] Stop losgelassen! <<<" << std::endl;
            m_actuators->lightRedOff();
        }
    }
    // E-STOP (Not-Halt)
    else if (sensor_id == ipc::BTN_ESTOP) {
        if (sensor_state == ipc::State::PRESSED) {
            std::cout << ">>> [ALERT] NOT-HALT GEDRUECKT! <<<" << std::endl;
            m_actuators->turnAllOff();
            m_actuators->driveStop();
            m_actuators->lightRedBlinkFast();

            // Partner mitalarmieren
            if (m_partnerCoid != -1) {
                MsgSendPulse(m_partnerCoid, SIGEV_PULSE_PRIO_INHERIT, ipc::PARTNER_ESTOP, 0);
            }
        }
        else if (sensor_state == ipc::State::RELEASED) {
            std::cout << ">>> [ALERT] Not-Halt entriegelt! <<<" << std::endl;
            m_actuators->lightRedOff();
        }
    }

    // ========================================================================
    // LICHTSCHRANKEN & SENSOREN (Nutzen BLOCKED / CLEARED / HIGH_ERROR)
    // ========================================================================

    // Einlauf (Entry)
    else if (sensor_id == ipc::LS_ENTRY) {
        if (sensor_state == ipc::State::BLOCKED) {
            std::cout << ">>> [Sensor] Werkstueck am Einlauf! <<<" << std::endl;
            m_actuators->driveRight();
            m_actuators->lightGreenBlinkSlow();
        }
        else if (sensor_state == ipc::State::CLEARED) {
            std::cout << ">>> [Sensor] Werkstueck hat Einlauf verlassen. <<<" << std::endl;
        }
    }
    // Analog-Sensor Höhenmessung (Auswertung der HAL)
    else if (sensor_id == ipc::HEIGHT) {
        if (sensor_state == ipc::State::BLOCKED) {
            std::cout << ">>> [ADC-Sensor] Messung gestartet (BLOCKED). <<<" << std::endl;
        }
        else if (sensor_state == ipc::State::CLEARED) {
            std::cout << ">>> [ADC-Sensor] Messung beendet (CLEARED). <<<" << std::endl;
        }
        else if (sensor_state == ipc::State::HIGH_ERROR) {
            std::cerr << ">>> [ALERT] Unzulaessige Werkstueckhoehe detektiert! <<<" << std::endl;
        }
    }
    // Metallsensor (Induktiv)
    else if (sensor_id == ipc::SENSOR_METAL) {
        if (sensor_state == ipc::State::BLOCKED) {
            std::cout << ">>> [Sensor] Metall-Werkstueck erkannt! <<<" << std::endl;
        }
        else if (sensor_state == ipc::State::CLEARED) {
            std::cout << ">>> [Sensor] Metall-Sensor wieder frei. <<<" << std::endl;
        }
    }
    // Weiche (Switch)
    else if (sensor_id == ipc::LS_SWITCH) {
        if (sensor_state == ipc::State::BLOCKED) {
            std::cout << ">>> [Sensor] Werkstueck erreicht die Weiche. <<<" << std::endl;
        }
        else if (sensor_state == ipc::State::CLEARED) {
            std::cout << ">>> [Sensor] Werkstueck hat die Weiche passiert. <<<" << std::endl;
        }
    }
    // Auslauf (End)
    else if (sensor_id == ipc::LS_END) {
        if (sensor_state == ipc::State::BLOCKED) {
            std::cout << ">>> [Sensor] Werkstueck am Auslauf! <<<" << std::endl;
            m_actuators->driveStop();
            m_actuators->lightGreenOff();
        }
    }
    // Rutsche (Chute)
    else if (sensor_id == ipc::LS_CHUTE) {
        if (sensor_state == ipc::State::BLOCKED) {
            std::cout << ">>> [Sensor] Rutsche belegt / Werkstueck ausrayaert! <<<" << std::endl;
            m_actuators->driveStop();
            m_actuators->lightGreenOff();
        }
    }
}

// ============================================================================
// EVENT HANDLER NETZWERK
// ============================================================================
void Dispatcher::handleNetworkPulse(uint32_t payload) {
    uint16_t sensor_id = ipc::decodeSensorID(payload);
    uint16_t message_type = ipc::decodeSensorState(payload);

    // Auswertung von reinen Netzwerknachrichten (Handshake & Signale)
    if (sensor_id == ipc::BTN_START) {
        if (message_type == ipc::State::PRESSED) {
            std::cout << ">>> [Netzwerk] Partner meldet: Start gedrueckt! <<<" << std::endl;
            if (m_actuators) m_actuators->lightGreenBlinkFast();
        }
        else if (message_type == ipc::State::RELEASED) {
            std::cout << ">>> [Netzwerk] Partner meldet: Start losgelassen! <<<" << std::endl;
            if (m_actuators) m_actuators->lightGreenOff();
        }
    }
    else if (message_type == ipc::NetworkMessage::REQ_RECEIVE) {
        std::cout << "[Dispatcher] Netzwerk: Partner fragt an -> Darf ich uebergeben?" << std::endl;
        // Hier spaeter: if (m_logik) m_logik->pruefeObUebergabeMoeglich();
    }
    else if (message_type == ipc::NetworkMessage::READY_RECEIVE) {
        std::cout << "[Dispatcher] Netzwerk: Partner meldet -> Bin bereit, lass kommen!" << std::endl;
        // Hier spaeter: if (m_logik) m_logik->uebergabeStarten();
    }
    else if (message_type == ipc::NetworkMessage::HANDOVER_SUCCESSFUL) {
        std::cout << "[Dispatcher] Netzwerk: Partner hat Werkstueck sicher erhalten." << std::endl;
    }
}


    <panel_attributes>Ebene 0 FSM
symbol=composite
valign=top
fontsize=14
--
Root-FSM (Fsm.cpp): Safety &amp; Connectivity Layer
Alle Zustaende auf Top-Level — Ebene 1 nur in ActiveRegion</panel_attributes>
    <additional_attributes/>
  </element>

